<resources>
    <string name="app_name">Archivist</string>

    <!-- Plan step 2.10: the foreground notification a long-running upload shows so
         Android doesn't kill the worker mid-transfer. -->
    <string name="upload_notification_channel_name">Backup</string>
    <!-- One notification for the whole batch, not one per file — see UploadWorker's
         NOTIFICATION_ID doc for why a per-file title/id caused constant pop-in/pop-out
         notification churn once several files upload concurrently. -->
    <string name="upload_notification_title">Backing up photos</string>
    <!-- Queue depth: how many photos are still waiting on this device, shown as the
         notification's content text and again in Settings > Sync. -->
    <plurals name="upload_queue_depth">
        <item quantity="one">%1$d photo left to upload</item>
        <item quantity="other">%1$d photos left to upload</item>
    </plurals>

    <!-- 2026-09-07: low-priority nudge shown when queued uploads can't proceed because
         the master key isn't in memory (e.g. right after sign-in on a fresh install, or
         after signing out/in as a different owner); see Sync settings' own toggle. -->
    <string name="needs_unlock_notification_channel_name">Backup paused</string>
    <string name="needs_unlock_notification_title">Backup paused</string>
    <string name="needs_unlock_notification_text">Open Archivist to resume uploading</string>
</resources>
